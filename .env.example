# Copiar a .env y completar. NO subir .env al repositorio.

# --- Correo (2FA, recuperación y alertas) ---
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Base de datos (obligatorias) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Seguridad de acceso ---
# Obligatoria fuera de modo debug. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Minutos sin actividad antes de cerrar la sesión, y segundos de aviso previo
SESSION_INACTIVIDAD_MINUTOS=30
SESSION_AVISO_SEGUNDOS=120
# País desde el que se permite el acceso (código ISO de 2 letras). Red interna siempre permitida.
PAIS_PERMITIDO=PY
# Base GeoIP local (DB-IP Lite Country, .mmdb); ruta relativa a la raíz del proyecto
GEOIP_DB_PATH=geoip/dbip-country-lite.mmdb
# Solo se usa con la app en modo debug: simula la IP del cliente para probar la validación por país
IP_SIMULADA=
# Días que dura la cookie "Recordar usuario" (guarda solo el CI/RUC)
RECORDAR_USUARIO_DIAS=30
# true cuando el sitio se sirve por HTTPS (cookies con el atributo Secure)
COOKIE_SECURE=false
