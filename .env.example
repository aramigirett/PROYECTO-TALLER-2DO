# Copiar a .env y completar. NO subir .env al repositorio.

# --- Correo (2FA, recuperación y alertas) ---
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Base de datos de la APLICACIÓN (obligatorias) ---
# La app se conecta con el rol odontoclinic_app (sin superusuario; ver app/dao/modulo_seguridad/schema_usuario_app.sql).
# Para otra PC de la red, DB_HOST es la IP del servidor (ver docs/acceso_red.md).
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Usuario PRIVILEGIADO (postgres) para migraciones, creación de roles y tests ---
# Lo usan ConexionAdmin y tests/_conexion_pruebas.py. La aplicación NO lo usa. TEST_DB_HOST/PORT/NAME son opcionales
# (por defecto, los DB_*).
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=

# --- Copias de seguridad (ver docs/backups.md) ---
# Rol de solo lectura odontoclinic_backup; la contraseña viaja por PGPASSWORD, nunca en la línea de comandos.
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
# Carpeta de destino: FUERA de OneDrive (las copias tienen datos de pacientes), p. ej. C:\OdontoClinic\backups
BACKUP_DIR=
# Carpeta bin de PostgreSQL de la MISMA versión que el servidor, p. ej. C:\Program Files\PostgreSQL\14\bin
PG_BIN_DIR=

# --- Seguridad de acceso ---
# Obligatoria fuera de modo debug. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Minutos sin actividad antes de cerrar la sesión, y segundos de aviso previo
SESSION_INACTIVIDAD_MINUTOS=30
SESSION_AVISO_SEGUNDOS=120
# País desde el que se permite el acceso (código ISO de 2 letras). Red interna siempre permitida.
PAIS_PERMITIDO=PY
# Base GeoIP local (DB-IP Lite Country, .mmdb); ruta relativa a la raíz del proyecto
GEOIP_DB_PATH=geoip/dbip-country-lite.mmdb
# Solo se usa con la app en modo debug: simula la IP del cliente para probar la validación por país
IP_SIMULADA=
# Días que dura la cookie "Recordar usuario" (guarda solo el CI/RUC)
RECORDAR_USUARIO_DIAS=30
# true cuando el sitio se sirve por HTTPS (cookies con el atributo Secure)
COOKIE_SECURE=false
